{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for Android",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "haptics:default",
    "notification:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "taobao://item.taobao.com/item.htm?id=*" }]
    },
    "store:default",
    "mobile-bridge:default"
  ]
}
