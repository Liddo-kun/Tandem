{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "permission": {},
  // UPSTREAM-DIVERGENCE: hide upstream skills Tandem does not use, so their descriptions stay out of
  // every session. A denied skill is left out of the advertised list and cannot be invoked.
  "permissions": [
    { "action": "skill", "resource": "sample-skill", "effect": "deny" },
    { "action": "skill", "resource": "rtl-aware-development", "effect": "deny" },
    { "action": "skill", "resource": "unit-tests", "effect": "deny" },
    { "action": "skill", "resource": "tui-tests", "effect": "deny" },
    { "action": "skill", "resource": "component-tests", "effect": "deny" },
    { "action": "skill", "resource": "app-e2e-tests", "effect": "deny" },
    { "action": "skill", "resource": "opencode-dev", "effect": "deny" },
  ],
  // UPSTREAM-DIVERGENCE: Effect v4 now lives in Effect-TS/effect (effect-smol is a stale beta), and
  // Tandem's logs and data live under ~/.local/share/tandem rather than ~/.local/share/opencode.
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect",
      "description": "Use for Effect v4 implementation details",
    },
    "tandem-local": {
      "path": "~/.local/share/tandem",
      "description": "Contains daily Tandem logs and data",
    },
  },
  "mcp": {},
  "tools": {
    "github-pr-search": false,
  },
}
